# Gemini API key for quote generation
# Get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model used for image generation
# Default: gemini-3.1-flash-image
# GEMINI_MODEL=gemini-3.1-flash-image

# Instagram Graph API — for publishing images (optional, post-MVP)
# See docs/instagram-setup.md for setup instructions
# INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
# INSTAGRAM_IG_USER_ID=your_instagram_ig_user_id_here

# Public base URL for image URLs sent to Instagram API
# In production, this would be your deployed URL
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

  "quotes": [
    {
      "id": "q-00001",
      "text": "The unexamined life is not worth living.",
      "author": null,
      "source": "imported",
      "status": "available",
      "usageCount": 0,
      "usedByAccounts": [],
      "createdAt": "2026-07-08T12:00:00.000Z",
